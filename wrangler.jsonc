{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "school-public-test"
  "main": "src/index.js",
  "compatibility_date": "2026-04-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VISITOR_STATS",
        "class_name": "VisitorStats"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VisitorStats"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
